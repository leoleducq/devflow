{
  "name": "@iziatask/devflow",
  "version": "0.4.1",
  "description": "Runnable environments for git worktrees: seeded Postgres, allocated ports, generated .env files and dev servers, one per branch.",
  "keywords": [
    "cli",
    "worktree",
    "git-worktree",
    "development-environment",
    "postgres",
    "docker",
    "monorepo",
    "herdr",
    "coding-agents"
  ],
  "license": "MIT",
  "author": "Léo Leducq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoleducq/devflow.git"
  },
  "homepage": "https://github.com/leoleducq/devflow#readme",
  "bugs": {
    "url": "https://github.com/leoleducq/devflow/issues"
  },
  "type": "module",
  "bin": {
    "devflow": "./bin/devflow.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "prisma/schema.prisma",
    "prisma/migrations",
    "skills/devflow/SKILL.md",
    "scripts/welcome.js",
    "scripts/herdr",
    "herdr-plugin.toml",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && tsup",
    "dev": "tsx src/index.ts",
    "check-types": "tsc --noEmit",
    "postinstall": "prisma generate --no-hints || true; node scripts/welcome.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "@linear/sdk": "^79.0.0",
    "@prisma/client": "6.6.0",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.2.0",
    "get-port": "^7.1.0",
    "listr2": "^11.1.0",
    "pg": "^8.20.0",
    "picocolors": "^1.1.1",
    "prisma": "6.6.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.20.0",
    "tsup": "^8.3.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2"
  }
}
